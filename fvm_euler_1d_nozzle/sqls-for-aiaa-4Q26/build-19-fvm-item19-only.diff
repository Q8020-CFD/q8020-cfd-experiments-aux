+class TestDeflationSpectrumSolveNelem2(TimedTestCase):
+    """hhl_solve on the archived nelem-2 system with -hhl_deflate_k 1:
+    internal (default), deflation with diagnostics off, and the reference
+    = the internal library bounds of the same encoded matrix (A' / sigma_max,
+    the spectrum dropped and its scale kept). About 5 s per solve."""
+
+    @classmethod
+    def setUpClass(cls) -> None:
+        cls.a_mat, cls.b_vec = helpers.load_system(helpers.SYSTEM_NELEM2_ITER0)
+        cls.runs = {}
+        cls.calls = {}
+        orig = QuantumHHL.solve_one_step
+
+        def same_matrix(self, *args, spectrum=None, **kwargs):
+            return orig(self, *args, a_scale=spectrum.a_scale, **kwargs)
+
+        for tag, extra in (('internal', {}),
+                           ('deflation', {'hhl_spectrum': 'deflation',
+                                          'hhl_spectral_diag': 'off'}),
+                           ('reference', {'hhl_spectrum': 'deflation'})):
+            solver = helpers.make_linsys_solver(2, 'HHL', hhl_deflate_k=1,
+                                                **extra)
+            with SpectralCallLog() as log:
+                if tag == 'reference':
+                    with mock.patch.object(QuantumHHL, 'solve_one_step',
+                                           same_matrix):
+                        dq, _ = helpers.quiet(solver.hhl_solve, cls.a_mat,
+                                              cls.b_vec, step=0)
+                else:
+                    dq, _ = helpers.quiet(solver.hhl_solve, cls.a_mat,
+                                          cls.b_vec, step=0)
+            qc = helpers.read_csv(helpers.find_one(
+                Path(solver.hhl_solver.output_dir), 'qc_metadata_*.csv'))
+            cls.runs[tag] = (dq, qc, solver.hhl_solver.qc_metadata)
+            cls.calls[tag] = log.calls
+
+    def test_clock_register_equals_internal(self) -> None:
+        n_clock = {t: r[1]['n_clock'][0] for t, r in self.runs.items()}
+        self.assertEqual(n_clock['deflation'], n_clock['reference'])
+        self.assertEqual(n_clock['deflation'], n_clock['internal'])
+        self.assertEqual(n_clock['deflation'], 6)
+        qc_d, qc_r = self.runs['deflation'][1], self.runs['reference'][1]
+        np.testing.assert_array_equal(qc_d['circ_qubits'],
+                                      qc_r['circ_qubits'])
+
+    def test_solution_matches_internal(self) -> None:
+        dq_d = self.runs['deflation'][0]
+        for tag in ('reference', 'internal'):
+            with self.subTest(vs=tag):
+                err = np.abs(dq_d - self.runs[tag][0]).max()
+                self.assertLessEqual(err, EQUIV_TOL, err)
+
+    def test_recorded_spectrum(self) -> None:
+        d = deflate(self.a_mat, self.b_vec, 1)
+        qc_d = self.runs['deflation'][1]
+        self.assertEqual(qc_d['hhl_spectrum'], ['deflation'])
+        self.assertEqual(qc_d['hhl_a_scale'][0], d.shift)
+        self.assertEqual(qc_d['hhl_kappa'][0], d.kappa_eff)
+        self.assertEqual(qc_d['hhl_kappa'][0], qc_d['kappa_eff'][0])
+        self.assertEqual(qc_d['hhl_lambda_max'][0], 1.0)
+        self.assertAlmostEqual(qc_d['hhl_lambda_min'][0], 1 / d.kappa_eff,
+                               delta=1e-15)
+        self.assertEqual(qc_d['t_spectrum_s'][0], 0.0)
+        for col in contract.QC_METADATA_DIAGNOSTIC_COLUMNS:
+            self.assertEqual(qc_d[col], [''], col)
+        # internal: the library's own values for H = double(pad(A' / rho))
+        qc_i = self.runs['internal'][1]
+        self.assertEqual(qc_i['hhl_spectrum'], ['internal'])
+        np.testing.assert_allclose(qc_i['hhl_kappa'], qc_i['kappa_eff'],
+                                   rtol=RTOL)
+        np.testing.assert_allclose(qc_i['hhl_a_scale'],
+                                   qc_i['lambda_max_orig'], rtol=0)
+        self.assertGreater(qc_i['t_spectrum_s'][0], 0.0)
+        meta_d = self.runs['deflation'][2]
+        self.assertEqual(meta_d['hhl_spectrum'], 'deflation')
+        self.assertEqual(meta_d['hhl_kappa'], d.kappa_eff)
+
+    def test_no_dense_spectral_call_besides_prestep_svd(self) -> None:
+        self.assertEqual(self.calls['deflation'], [('svd', 'deflation.py')])
+        # the default path, for contrast: pre-step SVD, the diagnostic
+        # cond / eigvals (twice), the spectral-radius eig and the library's
+        # cond / eigvals of H
+        self.assertEqual(sorted(self.calls['internal']), sorted([
+            ('svd', 'deflation.py'),
+            ('cond', 'math_tools.py'), ('eigvals', 'math_tools.py'),
+            ('eig', 'math_tools.py'),
+            ('cond', 'math_tools.py'), ('eigvals', 'math_tools.py'),
+            ('cond', 'numpy_matrix.py'), ('eigvals', 'numpy_matrix.py')]))
+
+    def test_option_rules(self) -> None:
+        for kwargs, text in (
