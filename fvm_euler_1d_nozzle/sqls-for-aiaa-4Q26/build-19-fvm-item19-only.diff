+class TestLoadedCircuitRecord(TimedTestCase):
+    """-loadcirc read-back of the spectrum record: generate_circuit with
+    load_circ on a saved file returns the record from the circuit metadata
+    and no library time (qpy.load is replaced by the generated circuit, see
+    TestHHLSpectrumNelem2CLI.test_qpy_files_carry_the_record). About 3 s."""
+
+    def test_record_from_loaded_metadata(self) -> None:
+        a_mat, b_vec = helpers.load_system(helpers.SYSTEM_NELEM2_ITER0)
+        d = deflate(a_mat, b_vec, 1)
+        spec = encoded_spectrum(d)
+        a_herm, b_herm, _ = encode(d.a_shifted, b_vec, spec.a_scale)
+        qh = helpers.quiet(QuantumHHL, backend_type='ideal',
+                           backend_method='statevector', nshots=0,
+                           verbosity=0,
+                           output_dir=str(helpers.new_outdir('specload_')))
+        circ, _ = qh.generate_circuit(a_herm, b_herm, deflate_k=1,
+                                      spectrum=spec)
+        record = dict(qh.circ_spectrum)
+        fname = qh.qpy_path('generated', 3, 0, 0, 1, 'deflation')
+        self.assertTrue(fname.endswith('_deflate1_specdeflation.qpy'), fname)
+        self.assertTrue(os.path.exists(fname))
+        qh.load_circ = True
+        qh.circ_spectrum, qh.t_library_spectrum_s = None, 1.0
+        with mock.patch('quantum_tools.qpy.load', return_value=[circ]):
+            loaded, _ = qh.generate_circuit(a_herm, b_herm, deflate_k=1,
+                                            spectrum=spec)
+        self.assertIs(loaded, circ)
+        self.assertEqual(qh.circ_spectrum, record)
+        self.assertEqual(qh.t_library_spectrum_s, 0.0)
+        # a circuit saved before item 19 has no record: empty cells
+        circ.metadata = {}
+        with mock.patch('quantum_tools.qpy.load', return_value=[circ]):
+            qh.generate_circuit(a_herm, b_herm, deflate_k=1, spectrum=spec)
+        self.assertIsNone(qh.circ_spectrum)
+        cols = hhl_spectrum.spectrum_columns('', spec.a_scale, None, 0.0)
+        self.assertEqual(cols['hhl_kappa'], '')
