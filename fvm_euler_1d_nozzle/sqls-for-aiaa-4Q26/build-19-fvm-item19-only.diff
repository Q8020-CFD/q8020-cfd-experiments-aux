+        a_mat, b_vec = helpers.load_system(system)
+        a_q = a_mat if k == 0 else deflate(a_mat, b_vec, k).a_shifted
+        a_herm, b_herm, scale = encode(a_q, b_vec)
+        kappa, lam_min, lam_max = internal_bounds(a_herm)
+        circ_int, _ = self.qh.generate_circuit(a_herm, b_herm)
+        rec_int = dict(self.qh.circ_spectrum)
+        spec = EncodedSpectrum('exact', scale, kappa, lam_min, lam_max)
+        no_cond, no_eigs = forbid_library_bounds()
+        with no_cond, no_eigs:
+            circ_sup, _ = self.qh.generate_circuit(a_herm, b_herm,
+                                                   spectrum=spec)
+        rec_sup = self.qh.circ_spectrum
+        key_int = circuit_key(circ_int)
+        self.assertRegex(key_int, r'^[0-9a-f]{64}$')
+        self.assertEqual(key_int, circuit_key(circ_sup))
+        self.assertEqual(circ_int.qregs[1].size, circ_sup.qregs[1].size)
+        self.assertEqual(rec_int['library_source'], 'internal')
+        self.assertEqual(rec_sup['library_source'], 'supplied')
+        for key in ('kappa', 'lambda_min', 'lambda_max'):
+            self.assertEqual(rec_int[key], rec_sup[key], key)
+        self.assertEqual(self.qh.t_library_spectrum_s, 0.0)
+        # the record travels in the circuit metadata (qpy keeps it)
+        self.assertEqual(circ_sup.metadata['hhl_spectrum'], rec_sup)
+
