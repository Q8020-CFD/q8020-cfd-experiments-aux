+"""Spectral data of the matrix the HHL circuit encodes (work-plan item 19).
+
+The HHL path hands the library H, not A. With A_q the system matrix (A, or
+the item-6 shifted A' under -hhl_deflate_k K > 0) and s the scale:
+
+    A_s = A_q / s                         (math_tools.scale_Ab)
+    P   = [[A_s, 0], [0, I_p]]            (convert_to_pow2, p >= 0 pad rows)
+    H   = [[0, P], [P^H, 0]]              (convert_system_to_herm)
+
+H is Hermitian with eigenvalues +-sigma_i(P), so its |eigenvalues| are the
+singular values of P: sigma_i(A_q) / s and, when p > 0, p ones. (If P is
+already Hermitian it is not doubled; then |eig(P)| = sigma(P) as well,
+since a Hermitian matrix is normal.) The ones never set a bound when
+sigma_min(A_q) <= s <= sigma_max(A_q). Then
+
+    lambda_min(H) = sigma_min(A_q) / s,   lambda_max(H) = sigma_max(A_q) / s,
+    kappa(H)      = sigma_max(A_q) / sigma_min(A_q)   (s and p drop out).
+
+The default s is the spectral radius rho(A_q); sigma_min <= rho <= sigma_max
+holds for every matrix, so the identity covers the default path too.
+
+For A' the singular values are sigma_k .. sigma_{N-1} of A plus k copies of
+sigma_max (0-based ascending; sigma_k is the (k+1)-th smallest of A). The
+pre-step SVD already holds both ends, so -hhl_spectrum deflation takes
+s = sigma_max and supplies
+
+    kappa = sigma_max / sigma_k = kappa_eff,
+    lambda_min = sigma_k / sigma_max,   lambda_max = 1,
+
+with no eig of A' and no SVD or eigendecomposition of H. The default s =
+rho(A') would need a full eig of A', which the pre-step does not give.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from deflation import Deflation
+
+# qc_metadata columns (HHL, after the item-6 columns): the spectrum source
+# label, the scale s of A_q, the kappa and |eigenvalue| bounds the circuit
+# was built from, and the wall seconds of the spectral work for them.
+SPECTRUM_COLUMNS = ('hhl_spectrum', 'hhl_a_scale', 'hhl_kappa',
+                    'hhl_lambda_min', 'hhl_lambda_max', 't_spectrum_s')
+
+
+@dataclass(frozen=True)
+class EncodedSpectrum:
+    """Supplied spectral data: the scale of A_q and the bounds of H."""
+
+    source: str
+    a_scale: float
+    kappa: float
+    lambda_min: float
+    lambda_max: float
+
+
+def encoded_bounds(sigma_max: float, sigma_min: float,
+                   a_scale: float) -> tuple[float, float, float]:
+    """(kappa, lambda_min, lambda_max) of H from the extreme singular values
+    of A_q and the scale s (module docstring). Needs 0 < sigma_min <= s <=
+    sigma_max, so the padding block's unit singular values sit inside the
+    range."""
+    sigma_max, sigma_min = float(sigma_max), float(sigma_min)
+    a_scale = float(a_scale)
+    if not 0.0 < sigma_min <= a_scale <= sigma_max:
+        raise ValueError(f'need 0 < sigma_min <= scale <= sigma_max; got '
+                         f'{sigma_min}, {a_scale}, {sigma_max}')
+    return sigma_max / sigma_min, sigma_min / a_scale, sigma_max / a_scale
+
+
+def encoded_spectrum(defl: Deflation) -> EncodedSpectrum:
+    """The -hhl_spectrum deflation data from the item-6 pre-step: s =
+    sigma_max, kappa = kappa_eff = sigma_max / sigma_k, lambda_min =
+    sigma_k / sigma_max, lambda_max = 1."""
+    sigma_max = defl.shift
+    sigma_k = float(defl.sigma[defl.k])
+    _, lambda_min, lambda_max = encoded_bounds(sigma_max, sigma_k, sigma_max)
+    # kappa as the kappa_eff column spells it, so the two are equal exactly
+    return EncodedSpectrum(source='deflation', a_scale=sigma_max,
+                           kappa=defl.kappa_eff, lambda_min=lambda_min,
+                           lambda_max=lambda_max)
+
+
+def spectrum_columns(label: str, a_scale: float, record: dict | None,
+                     t_spectrum_s: float) -> dict:
+    """The six qc_metadata columns. label: 'internal' | 'deflation', or ''
+    for a -loadcirc circuit saved without a spectrum record. record: the
+    circuit's {'kappa', 'lambda_min', 'lambda_max'} (None: empty cells).
+    t_spectrum_s: wall seconds of this step's spectral work for the circuit
+    (the spectral radius and the library bounds; 0.0 when supplied)."""
+    rec = record or {}
+
+    def cell(key: str) -> float | str:
+        val = rec.get(key)
+        return '' if val is None else float(val)
+
+    return {'hhl_spectrum': label, 'hhl_a_scale': float(a_scale),
+            'hhl_kappa': cell('kappa'), 'hhl_lambda_min': cell('lambda_min'),
+            'hhl_lambda_max': cell('lambda_max'),
+            't_spectrum_s': float(t_spectrum_s)}
