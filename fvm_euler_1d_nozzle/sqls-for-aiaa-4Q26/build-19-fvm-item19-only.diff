+                ({'hhl_spectral_diag': 'off'}, 'needs -hhl_spectrum'),
+                ({'hhl_spectrum': 'sqls'}, 'hhl_spectrum must be one of')):
+            with self.subTest(**kwargs):
+                with self.assertRaises(ValueError) as ctx:
+                    helpers.make_linsys_solver(2, 'HHL', **kwargs)
+                self.assertIn(text, str(ctx.exception))
