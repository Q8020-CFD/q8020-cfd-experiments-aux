+class TestHHLSpectrumCLIValidation(TimedTestCase):
+    """Parse-time rejections (exit 2, nothing written)."""
+
+    def _rejected(self, extra: list[str], solver: str = 'HHL') -> str:
+        outdir = helpers.new_outdir('rejected_')
+        run = helpers.run_solver(['-nelem', '2', '-linsolver', solver,
+                                  '-iters', '1', *extra, *BASE_ARGS],
+                                 outdir=outdir, check=False)
+        self.assertEqual(run.returncode, 2, run.stderr)
+        self.assertEqual(list(outdir.iterdir()), [])
+        return run.stderr
+
+    def test_deflation_needs_rank(self) -> None:
+        for extra in (['-hhl_spectrum', 'deflation'],
+                      ['-hhl_spectrum', 'deflation', '-hhl_deflate_k', '0']):
+            with self.subTest(extra=extra):
+                err = self._rejected(extra)
+                self.assertIn('-hhl_spectrum deflation', err)
+                self.assertIn('-hhl_deflate_k >= 1', err)
+
+    def test_diag_off_needs_deflation(self) -> None:
+        err = self._rejected(['-hhl_spectral_diag', 'off',
+                              '-hhl_deflate_k', '1'])
+        self.assertIn('-hhl_spectral_diag off needs -hhl_spectrum deflation',
+                      err)
+
+    def test_hhl_only(self) -> None:
+        for solver in ('LU', 'SQLS'):
+            with self.subTest(solver=solver):
+                err = self._rejected(['-hhl_spectrum', 'deflation'], solver)
+                self.assertIn('HHL only', err)
+
+    def test_unknown_choice(self) -> None:
+        err = self._rejected(['-hhl_spectrum', 'sqls'])
+        self.assertIn('invalid choice', err)
