+"""Item 19: supplied spectral data on the HHL path (hhl_spectrum.py, the
+fork's construct_circuit(condition_bound=, eigenvalue_bounds=)).
+
+(1) The transformation of the pre-step singular values to the bounds of
+the encoded matrix H (scale, pad, Hermitian-double) holds to 1e-10 against
+np.linalg.cond / eigvals of H on every archived Jacobian, k = 1 to 4, on a
+synthetic 8 x 8 system (no padding) and a 5 x 5 one (3 pad rows), and for
+the default spectral-radius scale. (2) Supplying exactly the internal
+values builds the identical circuit (quantum_tools.circuit_key) at nelem 2
+(k = 0 and 1) and on the archived nelem-5 iteration-0 Jacobian deflated
+at k = 1 (construction only), with the library's bound calls forbidden.
+(3) nelem 2, k = 1, -hhl_spectrum deflation: same clock register as the
+internal computation, solution equal to 1e-10 to both the internal bounds
+of the same encoded matrix and the default spectral-radius path; the
+fvm and fork code make no dense spectral call besides the pre-step SVD.
+(4) The CLI: columns, empty diagnostic cells, pickle keys, the record in
+the saved qpy circuits and its -loadcirc read-back, parse-time
+rejections.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+from pathlib import Path
+from unittest import mock
+
+import numpy as np
+import scipy.linalg
+import linear_solvers
+from linear_solvers.matrices.numpy_matrix import NumPyMatrix
+
+from tests import contract, helpers, test_deflation
+from tests.helpers import BASE_ARGS, TimedTestCase
+
+import hhl_spectrum
+import math_tools
+from deflation import deflate
+from hhl_spectrum import EncodedSpectrum, encoded_bounds, encoded_spectrum
+from quantum_tools import QuantumHHL, circuit_key
+
+RTOL = 1e-10
+EQUIV_TOL = 1e-10
+KS = (1, 2, 3, 4)
+HHL_SV_SPEC_NELEM2_ARGS = [*test_deflation.HHL_SV_DEFLATE1_NELEM2_ARGS,
+                           '-hhl_spectrum', 'deflation',
+                           '-hhl_spectral_diag', 'off']
+# dense spectral routines watched in the fvm and fork sources
+SPECTRAL_FUNCS = ('svd', 'cond', 'eig', 'eigvals', 'eigh', 'eigvalsh')
+FORK_DIR = os.path.dirname(os.path.abspath(linear_solvers.__file__))
+# fixed synthetic systems: 8 x 8 (a power of 2, no padding) and 5 x 5
+_RNG = np.random.default_rng(19)
+SYNTHETIC = {n: (np.eye(n) * 3.0 + _RNG.standard_normal((n, n)),
+                 _RNG.standard_normal(n)) for n in (8, 5)}
+
+
+def encode(a_q: np.ndarray, b_vec: np.ndarray,
+           rho: float | None = None) -> tuple[np.ndarray, np.ndarray, float]:
+    """H, b_H and the scale, through the solver's own functions.
+    convert_to_pow2 returns None for a size that is already a power of 2
+    (never an fvm size, 3 * nelem); that case is unpadded here."""
+    a_s, b_s, scale, _ = math_tools.scale_Ab(a_q, b_vec, verbosity=0,
+                                             rho=rho)
+    if math_tools.next_power_of_2(a_s.shape[0]) == a_s.shape[0]:
+        a_p, b_p = a_s, b_s
+    else:
+        a_p, b_p = math_tools.convert_to_pow2(a_s, b_s, verbosity=0)
+    a_h, b_h = math_tools.convert_system_to_herm(a_p, b_p, verbosity=0)
+    return a_h, b_h, scale
+
+
+def internal_bounds(a_herm: np.ndarray) -> tuple[float, float, float]:
+    """(kappa, lambda_min, lambda_max) as the fork computes them."""
+    mat = NumPyMatrix(a_herm)
+    lam_min, lam_max = mat.eigs_bounds()
+    return mat.condition_bounds()[1], lam_min, lam_max
+
+
+def clock_qubits(kappa: float, n_b: int) -> int:
+    """The fork's rule nl = max(nb + 1, ceil(log2(kappa + 1))) + 1."""
+    return max(n_b + 1, int(np.ceil(np.log2(kappa + 1)))) + 1
+
+
+class SpectralCallLog:
+    """Context manager recording dense spectral calls (numpy.linalg and
+    scipy.linalg) made directly from the fvm modules (repo root) or the
+    HHL fork: a list of (function, file name)."""
+
+    def __init__(self) -> None:
+        self.calls: list[tuple[str, str]] = []
+        self._patches = []
+
+    def _wrap(self, name: str, func):
+        def wrapper(*args, **kwargs):
+            path = sys._getframe(1).f_code.co_filename
+            if (os.path.dirname(path) == str(helpers.REPO)
+                    or path.startswith(FORK_DIR)):
+                self.calls.append((name, os.path.basename(path)))
+            return func(*args, **kwargs)
+        return wrapper
+
+    def __enter__(self) -> 'SpectralCallLog':
+        for mod in (np.linalg, scipy.linalg):
+            for name in SPECTRAL_FUNCS:
+                if hasattr(mod, name):
+                    patch = mock.patch.object(
+                        mod, name, self._wrap(name, getattr(mod, name)))
+                    patch.start()
+                    self._patches.append(patch)
+        return self
+
+    def __exit__(self, *exc) -> None:
+        for patch in reversed(self._patches):
+            patch.stop()
+
+
+def forbid_library_bounds():
+    """Patches making NumPyMatrix.condition_bounds / eigs_bounds raise."""
+    err = AssertionError('library spectral bound computed')
+    return (mock.patch.object(NumPyMatrix, 'condition_bounds',
+                              side_effect=err),
+            mock.patch.object(NumPyMatrix, 'eigs_bounds', side_effect=err))
+
+
+class TestEncodedSpectrumDerivation(TimedTestCase):
+    """sigma_max, sigma_k of A -> kappa and |eigenvalue| bounds of H."""
+
+    def check(self, a_q: np.ndarray, b_vec: np.ndarray,
+              expect: tuple[float, float, float], rho: float | None) -> None:
+        a_herm, _, _ = encode(a_q, b_vec, rho)
+        kappa, lam_min, lam_max = internal_bounds(a_herm)
+        np.testing.assert_allclose(expect, (kappa, lam_min, lam_max),
+                                   rtol=RTOL)
+        n_b = int(np.log2(a_herm.shape[0]))
+        self.assertEqual(clock_qubits(expect[0], n_b),
+                         clock_qubits(kappa, n_b))
+
+    def test_deflation_spectrum_on_archived_systems(self) -> None:
+        for system in helpers.ALL_SYSTEMS:
+            a_mat, b_vec = helpers.load_system(system)
+            for k in KS:
+                with self.subTest(system=system, k=k):
+                    d = deflate(a_mat, b_vec, k)
+                    spec = encoded_spectrum(d)
+                    self.assertEqual(spec.source, 'deflation')
+                    self.assertEqual(spec.a_scale, d.shift)
+                    self.assertEqual(spec.kappa, d.kappa_eff)
+                    self.assertEqual(spec.lambda_max, 1.0)
+                    self.assertAlmostEqual(spec.lambda_min,
+                                           1.0 / d.kappa_eff, delta=1e-15)
+                    self.check(d.a_shifted, b_vec, (spec.kappa,
+                               spec.lambda_min, spec.lambda_max),
+                               spec.a_scale)
+
+    def test_deflation_spectrum_synthetic(self) -> None:
+        for n, (a_mat, b_vec) in SYNTHETIC.items():
+            for k in (1, 2, 3):
+                with self.subTest(n=n, k=k):
+                    d = deflate(a_mat, b_vec, k)
+                    spec = encoded_spectrum(d)
+                    self.check(d.a_shifted, b_vec, (spec.kappa,
+                               spec.lambda_min, spec.lambda_max),
+                               spec.a_scale)
+
+    def test_default_scale_identity(self) -> None:
+        """The same identity with s = rho(A_q), the default path, k = 0
+        to 2: kappa(H) = sigma_max / sigma_min of A_q, bounds sigma / rho."""
+        systems = [helpers.load_system(s) for s in helpers.ALL_SYSTEMS]
+        systems += list(SYNTHETIC.values())
+        for i, (a_mat, b_vec) in enumerate(systems):
+            for k in (0, 1, 2):
+                with self.subTest(system=i, k=k):
+                    a_q = a_mat if k == 0 else deflate(a_mat, b_vec,
+                                                       k).a_shifted
+                    sig = np.linalg.svd(a_q, compute_uv=False)
+                    _, _, rho = encode(a_q, b_vec)
+                    self.check(a_q, b_vec, encoded_bounds(sig.max(),
+                               sig.min(), rho), None)
+
+    def test_scale_outside_range_rejected(self) -> None:
+        for scale in (0.5, 11.0):
+            with self.subTest(scale=scale), self.assertRaises(ValueError):
+                encoded_bounds(10.0, 1.0, scale)
+        with self.assertRaises(ValueError):
+            encoded_bounds(10.0, 0.0, 5.0)
+        self.assertEqual(encoded_bounds(10.0, 2.0, 10.0), (5.0, 0.2, 1.0))
+
+    def test_columns_and_choices_match_contract(self) -> None:
+        self.assertEqual(list(hhl_spectrum.SPECTRUM_COLUMNS),
+                         contract.QC_METADATA_SPECTRUM_COLUMNS)
